# إعدادات الإنتاج (Docker Compose). لا ترفعي هذا الملف بعد ملئه إلى أي مستودع.
NODE_ENV=production
NEXTAUTH_URL=https://lughati.example.edu.sa
# openssl rand -base64 32
NEXTAUTH_SECRET=
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"  — احفظي نسخة في خزنة منفصلة
FIELD_ENCRYPTION_KEY=
# كلمة مرور القاعدة نفسها الموجودة في deploy/secrets/db_password
DATABASE_URL=postgresql://lughati:CHANGE_ME@db:5432/lughati
REQUIRE_STAFF_2FA=true
FILE_STORAGE_DRIVER=local
PDF_ENGINE=auto
