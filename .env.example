#   docker run -d --name riyadiyati-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=riyadiyati -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/riyadiyati"

# NextAuth
