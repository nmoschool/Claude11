# قاعدة البيانات PostgreSQL (محلياً أو مُدارة — راجع DEPLOY.md)
#   docker run -d --name lughati-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=lughati -p 5432:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lughati"

# NextAuth — سلسلة عشوائية طويلة: openssl rand -base64 32
NEXTAUTH_SECRET="غيّري-هذه-القيمة"
NEXTAUTH_URL="http://localhost:3000"

# مفتاح تشفير الحقول الحساسة (32 بايت base64). لا تغيّريه بعد إدخال بيانات حقيقية
# وإلا تعذّر فك تشفيرها. احفظي نسخة منه خارج الخادم.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""

# التحقق الثنائي إلزامي للطاقم (اتركيه true في أي بيئة فيها بيانات حقيقية)
REQUIRE_STAFF_2FA="true"

# حساب مدير النظام الذي ينشئه سكربت seed
SEED_ADMIN_EMAIL="admin@school.sa"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_SCHOOL_NAME="المدرسة الابتدائية النموذجية"

# اضبطيها true فقط خلف وكيل موثوق يضبط X-Forwarded-For (Vercel/Netlify/Nginx)
TRUST_PROXY="false"

# تخزين ملفات الطالبات
#   local: مجلد على القرص (تطوير / خادم خاص VPS) — خارج public ولا يُخدم إلا عبر API
#   s3:    أي خدمة متوافقة مع S3 بحاوية خاصة (إلزامي على Netlify/Vercel لعدم وجود قرص دائم)
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_DIR=".data/uploads"
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""            # لغير AWS (مثل MinIO أو مزود سحابي محلي)
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
